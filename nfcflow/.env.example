# ===== Supabase =====
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRETA — somente servidor
SUPABASE_SERVICE_ROLE_KEY=

# ===== App =====
NEXT_PUBLIC_APP_NAME=NFCFLOW
# URL pública do site (ex.: https://seudominio.com) — usada nos QR Codes e no webhook
NEXT_PUBLIC_APP_URL=
# Domínio PERMANENTE dos QR Codes já impressos (ex.: https://dominio-antigo.com). Opcional: se vazio, usa NEXT_PUBLIC_APP_URL.
# Ao trocar o domínio do app, mantenha este valor no endereço antigo. Veja DOMINIO-QR.md
NEXT_PUBLIC_QR_BASE_URL=
OWNER_EMAIL=
NEXT_PUBLIC_OWNER_EMAIL=

# ===== Pagamentos =====
PAYMENT_PROVIDER=MERCADO_PAGO
# SECRETAS — somente servidor
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_PIX_EXPIRATION_MINUTES=30

# ===== Correios =====
# SECRETA — somente servidor
CORREIOS_API_TOKEN=
CORREIOS_API_URL=
CORREIOS_ORIGIN_ZIP=
# Códigos de serviço do seu contrato, separados por vírgula (ex.: PAC e SEDEX)
CORREIOS_SERVICE_CODES=
CORREIOS_UNIT_WEIGHT_GRAMS=
CORREIOS_PACKAGE_LENGTH_CM=
CORREIOS_PACKAGE_WIDTH_CM=
CORREIOS_PACKAGE_HEIGHT_CM=
# Frete provisório (R$) usado SOMENTE enquanto os Correios não estiverem configurados
SHIPPING_FALLBACK_AMOUNT=

# ===== Google =====
# SECRETA — somente servidor
GOOGLE_PLACES_API_KEY=
GOOGLE_MAPS_API_KEY=

# ===== Segurança / rotinas =====
# Protege /api/cron/release-reservations
CRON_SECRET=
# Sal para o hash de IP dos scans
QR_IP_HASH_SALT=

# ===== WhatsApp (opcional) =====
# Usado só se o ADMIN ainda não configurou o número em Suporte. Ex.: https://wa.me/55DDDNUMERO
NEXT_PUBLIC_WHATSAPP_LINK=
